<?xml version="1.0" encoding="utf-8" ?>
<component name="AppsScreen" extends="Group">
    <interface>
        <field id="focusIn" type="boolean" alwaysNotify="true" onChange="onFocusIn" />
        <field id="action" type="assocarray" alwaysNotify="true" />
        <field id="apps" type="array" onChange="buildTiles" />
        <field id="status" type="string" onChange="showStatus" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/Common.brs" />
    <script type="text/brightscript" uri="pkg:/components/AppsScreen.brs" />
    <children>
        <Label text="Applications" translation="[0,80]" color="0xE8E2D4FF">
            <Font role="font" uri="font:BoldSystemFontFile" size="64" />
        </Label>
        <Label id="statusLabel" text="Chargement de vos applications…" translation="[0,170]"
            width="1340" height="100" wrap="true" maxLines="3" color="0x8A9486FF">
            <Font role="font" uri="font:SystemFontFile" size="28" />
        </Label>
        <MarkupGrid id="grid" translation="[0,290]"
            itemComponentName="Tile" itemSize="[320,200]" itemSpacing="[30,28]"
            numColumns="4" numRows="3" drawFocusFeedback="false"
            vertFocusAnimationStyle="floatingFocus" />
    </children>
</component>
