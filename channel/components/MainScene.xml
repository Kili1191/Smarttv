<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
    <children>
        <Group id="home">
            <Poster id="bg" uri="pkg:/images/bg.jpg" width="1920" height="1080" />

            <!-- Breathing circle: 4s in, 4s out -->
            <Poster id="halo" uri="pkg:/images/halo.png" width="460" height="460"
                translation="[730,150]" scaleRotateCenter="[230,230]" />
            <Poster id="core" uri="pkg:/images/core.png" width="300" height="300"
                translation="[810,230]" scaleRotateCenter="[150,150]" />
            <Label id="breathLabel" text="Inspirez" width="1920" horizAlign="center"
                translation="[0,640]" font="font:MediumSystemFont" color="0xC9B896FF" />

            <Group id="chrome">
                <Label id="greeting" translation="[140,90]"
                    font="font:LargeBoldSystemFont" color="0xE8E2D4FF" />
                <Label id="brand" text="MAISON DU CALME" translation="[140,160]"
                    font="font:SmallSystemFont" color="0x8A9486FF" />
                <Label id="clock" width="300" horizAlign="right" translation="[1480,90]"
                    font="font:LargeSystemFont" color="0xE8E2D4FF" />

                <RowList id="sessions" translation="[0,760]"
                    itemComponentName="SessionCard"
                    numRows="1"
                    itemSize="[1920,240]"
                    rowItemSize="[[380,220]]"
                    rowItemSpacing="[[30,0]]"
                    showRowLabel="[false]"
                    focusXOffset="[140]"
                    rowFocusAnimationStyle="floatingFocus"
                    drawFocusFeedback="false" />
            </Group>

            <Group id="nowPlaying" visible="false">
                <Label id="nowTitle" width="1920" horizAlign="center" translation="[0,760]"
                    font="font:LargeBoldSystemFont" color="0xE8E2D4FF" />
                <Label text="Retour pour arrêter" width="1920" horizAlign="center"
                    translation="[0,840]" font="font:SmallSystemFont" color="0x8A9486FF" />
            </Group>
        </Group>

        <Video id="video" width="1920" height="1080" visible="false" />
        <Audio id="audio" />

        <Animation id="breathe" duration="8" repeat="true" easeFunction="inOutQuad">
            <Vector2DFieldInterpolator fieldToInterp="core.scale" key="[0.0, 0.5, 1.0]"
                keyValue="[[0.72,0.72],[1.0,1.0],[0.72,0.72]]" />
            <Vector2DFieldInterpolator fieldToInterp="halo.scale" key="[0.0, 0.5, 1.0]"
                keyValue="[[0.7,0.7],[1.12,1.12],[0.7,0.7]]" />
            <FloatFieldInterpolator fieldToInterp="halo.opacity" key="[0.0, 0.5, 1.0]"
                keyValue="[0.35, 1.0, 0.35]" />
        </Animation>

        <Timer id="phaseTimer" duration="4" repeat="true" />
        <Timer id="clockTimer" duration="15" repeat="true" />
    </children>
</component>
